#!/usr/bin/env bash
# Refuses a push whose code differs from what scripts/verify.sh last verified (reference-app/,
# scripts/, .githooks/). It doesn't run verify.sh itself: that takes over ten minutes, and GitHub
# drops a push connection held open that long. Run verify.sh first, then push.
# Skill text and guides are not part of the check. Skip once with: git push --no-verify
set -euo pipefail
REPO="$(git rev-parse --show-toplevel)"
# shellcheck source=../scripts/lib/fingerprint.sh
. "$REPO/scripts/lib/fingerprint.sh"
zero="0000000000000000000000000000000000000000"
record="$(verified_record "$REPO")"
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ -f "$record" ] && [ "$(commit_fingerprint "$REPO" "$local_sha")" = "$(cat "$record")" ]; then
        echo "pre-push: $local_ref is the code verify.sh last verified"
        continue
    fi
    echo "pre-push: $local_ref contains code verify.sh hasn't verified. Run it first:" >&2
    echo "  sg docker -c scripts/verify.sh     (or scripts/verify.sh if your shell is in the docker group)" >&2
    echo "then push again. Skip once with git push --no-verify." >&2
    exit 1
done
