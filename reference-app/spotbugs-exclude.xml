<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs + FindSecBugs false positives (house-review CFG-11). One entry per class and bug pattern (and method, where the
  finding is one method's), each with the reason it is not a defect here. Never a package or a whole category: a new
  finding of the same kind elsewhere must still fail the build. A real finding is fixed, never listed.
-->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- The JPA static metamodel (Entity_), generated by hibernate-processor: Hibernate writes its fields at startup.
         The one pattern entry: every such class is generated, none is written by hand. -->
    <Match>
        <Class name="~.*\.(domain|persistence)\.[A-Za-z]+_"/>
        <Bug pattern="UUF_UNUSED_PUBLIC_OR_PROTECTED_FIELD,UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/>
    </Match>

    <!-- Spring singletons whose constructors refuse a missing setting (a bulkhead or circuit breaker the
         configuration lacks, a constraint two modules claim): the refusal stops startup, so no half-built object is
         ever used, and the classes stay open for Spring's proxies (JAVA-03). -->
    <Match>
        <Class name="com.example.app.common.admission.AdmissionControlFilter"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Class name="com.example.app.common.exception.ConstraintViolationCodes"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!-- sign-in:begin -->
    <Match>
        <Class name="com.example.app.user.service.BreachedPasswordCheck"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!-- session-version:begin -->
    <Match>
        <Class name="com.example.app.user.service.SessionVersionService"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!-- session-version:end -->

    <!-- Keeps the connection factory Spring injects: sharing the application's one Redis client is the point. -->
    <Match>
        <Class name="com.example.app.common.ratelimit.RedisRateLimiter"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- sign-in:end -->

    <!-- Jitter on Retry-After: it spreads clients out, it is no secret. -->
    <Match>
        <Class name="com.example.app.common.web.RetryAfterProperties$Range"/>
        <Method name="pickSeconds"/>
        <Bug pattern="PREDICTABLE_RANDOM"/>
    </Match>
    <!-- example:begin -->

    <!-- A JPA relation holds the managed entity; it can't be a copy. -->
    <Match>
        <Class name="com.example.app.todo.domain.Todo"/>
        <Method name="moveTo"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- The two tags of a merge, locked and managed, handed between the halves of one call: a copy would detach them. -->
    <Match>
        <Class name="com.example.app.todo.dto.internal.TagMerge"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- example:end -->
</FindBugsFilter>
