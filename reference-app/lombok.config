# The project's root: no lombok.config above it applies.
config.stopBubbling = true

# Spring reads a qualifier from a constructor's parameter. On a field of a @RequiredArgsConstructor bean,
# Lombok drops it unless it is listed here, and the bean gets the wrong candidate or none (JAVA-26).
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier

# JaCoCo leaves out what Lombok generates (equals, getters, builders): code no test of ours should have to cover.
lombok.addLombokGeneratedAnnotation = true
