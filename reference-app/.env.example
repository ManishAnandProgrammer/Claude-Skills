# Copy to .env and fill in. Variables without a value here have no default and are required.
SPRING_PROFILES_ACTIVE=dev
APP_ENV=local

DB_HOST=localhost
DB_PORT=5432
# The database the app connects to, and the one compose.yaml creates: spring.application.name by convention.
DB_NAME=reference
DB_USER=
DB_PASSWORD=

# sign-in:begin
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# sign-in:end

# media:begin
# Uploaded files: an S3 bucket, or a bucket of an S3-compatible store (MEDIA_ENDPOINT and
# MEDIA_PATH_STYLE_ACCESS=true). Credentials come from the AWS SDK's default chain: an IAM role in
# production, never application config. The values below are for compose.yaml's local store
# (media-store), which creates MEDIA_BUCKET and takes the two keys as its root account: local only,
# not secrets. For a real bucket, drop MEDIA_ENDPOINT and MEDIA_PATH_STYLE_ACCESS and the keys.
MEDIA_BUCKET=reference-media
MEDIA_REGION=eu-central-1
MEDIA_ENDPOINT=http://localhost:7070
MEDIA_PATH_STYLE_ACCESS=true
AWS_ACCESS_KEY_ID=local-access-key
AWS_SECRET_ACCESS_KEY=local-secret-key-not-a-secret
# media:end

# At least 32 bytes, random: openssl rand -base64 48
JWT_SECRET=
# Keys hashed personal data (client addresses, emails); at least 32 bytes, random, unlike JWT_SECRET
PERSONAL_DATA_PEPPER=

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional, with defaults: dev/local values shown, prod defaults in config/*-prod.yml.
# DB_POOL_SIZE=10
# DB_POOL_MIN_IDLE=5
# LIQUIBASE_LOCK_TIMEOUT=5s         # how long a migration waits for a table lock before failing
# ADMISSION_MAX_CONCURRENT=20        # at least 2 x DB_POOL_SIZE (checked at startup)
# ADMISSION_SIGN_IN_MAX_CONCURRENT=8 # sign-ins in flight (bcrypt is CPU-bound): about 2 x CPU cores
# SERVER_PORT=8080
# MANAGEMENT_PORT=8081
# JWT_ISSUER=reference              # defaults to spring.application.name
# JWT_ACCESS_TTL=15m                 # at most 15m (checked at startup)
# JWT_REFRESH_TTL=30d
# TRACING_SAMPLING=0.1
# BREACHED_PASSWORD_CHECK_ENABLED=true  # signup asks Have I Been Pwned (fail-open)
# DIAGNOSTICS_KEEP=5                 # container only: diagnostics directories kept in /diagnostics
