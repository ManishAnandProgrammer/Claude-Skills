<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs + FindSecBugs false positives (house-review CFG-11). One entry per class and bug pattern (and method, where the
  finding is one method's), each with the reason it is not a defect here. Never a package or a whole category: a new
  finding of the same kind elsewhere must still fail the build. A real finding is fixed, never listed.
-->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- The JPA static metamodel (Entity_), generated by hibernate-processor: Hibernate writes its fields at startup.
         The one pattern entry: every such class is generated, none is written by hand. -->
    <Match>
        <Class name="~.*\.(domain|persistence)\.[A-Za-z]+_"/>
        <Bug pattern="UUF_UNUSED_PUBLIC_OR_PROTECTED_FIELD,UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/>
    </Match>

    <!-- Spring singletons whose constructors refuse a missing setting (a bulkhead or circuit breaker the
         configuration lacks, a constraint two modules claim): the refusal stops startup, so no half-built object is
         ever used, and the classes stay open for Spring's proxies (JAVA-03). -->
    <Match>
        <Class name="com.example.app.common.admission.AdmissionControlFilter"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Class name="com.example.app.common.exception.ConstraintViolationCodes"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!-- sign-in:begin -->
    <Match>
        <Class name="com.example.app.user.service.BreachedPasswordCheck"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!-- session-version:begin -->
    <Match>
        <Class name="com.example.app.user.service.SessionVersionService"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!-- session-version:end -->

    <!-- Keeps the connection factory Spring injects: sharing the application's one Redis client is the point. -->
    <Match>
        <Class name="com.example.app.common.ratelimit.RedisRateLimiter"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- sign-in:end -->

    <!-- Jitter on Retry-After: it spreads clients out, it is no secret. -->
    <Match>
        <Class name="com.example.app.common.web.RetryAfterProperties$Range"/>
        <Method name="pickSeconds"/>
        <Bug pattern="PREDICTABLE_RANDOM"/>
    </Match>
    <!-- example:begin -->

    <!-- A JPA relation holds the managed entity; it can't be a copy. -->
    <Match>
        <Class name="com.example.app.todo.domain.Todo"/>
        <Method name="moveTo"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- The two tags of a merge, locked and managed, handed between the halves of one call: a copy would detach them. -->
    <Match>
        <Class name="com.example.app.todo.dto.internal.TagMerge"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- example:end -->

    <!-- Low priority (threshold Low): the findings below are informational or false positives at these classes. -->

    <!-- CRLF_INJECTION_LOGS: the deployed profile writes one JSON object a line (logback-spring.xml, LogstashEncoder),
         which escapes a line break in any logged value, so no value can forge an entry or split a line; dev and test
         write text on a developer's machine. One entry per class that logs a value, so a new one is looked at: what
         it logs is still never personal data (house-review SEC-04). -->
    <Match>
        <Class name="com.example.app.common.admission.AdmissionControlFilter"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.common.exception.GlobalExceptionHandler"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.common.logging.RequestCompletionLogFilter"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.common.security.AllowedActionMapper"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.common.security.Decision"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <!-- change-history:begin -->
    <Match>
        <Class name="com.example.app.common.persistence.ChangeHistoryActor"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <!-- change-history:end -->
    <!-- roles:begin -->
    <Match>
        <Class name="com.example.app.user.domain.PermissionCodes"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.service.AccessRoleManager"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.service.PersonAccessService"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <!-- roles:end -->
    <!-- sign-in:begin -->
    <Match>
        <Class name="com.example.app.common.ratelimit.RedisRateLimiter"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.service.AccountStatusService"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.service.AuthService"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.service.BreachedPasswordCheck"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.service.FailureCountingInterceptor"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.service.RolePermissions"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.service.TokenService"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.service.UserService"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <!-- session-version:begin -->
    <Match>
        <Class name="com.example.app.common.security.SessionVersionFilter"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.service.SessionVersionService"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <!-- session-version:end -->
    <!-- sign-in:end -->
    <!-- media:begin -->
    <Match>
        <Class name="com.example.app.media.service.MediaCleanupJob"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.media.service.MediaVerificationJob"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <!-- media:end -->

    <!-- SPRING_ENDPOINT: informational, FindSecBugs marks every request handler for a reviewer. Who may call each
         endpoint is its role annotation or owner scope, proven by its tests (403 and 404 for another user's record);
         what it accepts is its request record's validation. One entry per controller, written with the controller
         (crud-gen generates it with the entity's). -->
    <!-- sign-in:begin -->
    <Match>
        <Class name="com.example.app.user.controller.AuthController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.controller.UserController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- roles:begin -->
    <Match>
        <Class name="com.example.app.user.controller.AccessRoleController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.controller.PermissionCatalogueController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.controller.PersonAccessController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- roles:end -->
    <!-- sign-in:end -->
    <!-- metadata:begin -->
    <Match>
        <Class name="com.example.app.metadata.controller.MetadataController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- metadata:end -->
    <!-- media:begin -->
    <Match>
        <Class name="com.example.app.media.controller.UploadPolicyController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Class name="com.example.app.media.controller.UploadUrlController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- media:end -->
    <!-- example:begin -->
    <Match>
        <Class name="com.example.app.planning.controller.PlanController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Class name="com.example.app.todo.controller.TagController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Class name="com.example.app.todo.controller.TodoController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Class name="com.example.app.todo.controller.TodoListController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- example:end -->

    <!-- The request id echoed from X-Request-Id only when it matches a short pattern of safe characters; otherwise a
         new one. -->
    <Match>
        <Class name="com.example.app.common.logging.RequestLogContextFilter"/>
        <Method name="requestIdFrom"/>
        <Bug pattern="SERVLET_HEADER"/>
    </Match>
    <!-- An AppException is never serialized: it lives for one request and ends as a Problem Details body. -->
    <Match>
        <Class name="com.example.app.common.exception.AppException"/>
        <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED"/>
    </Match>
    <!-- HttpSecurity.build() declares Exception; the bean method passes it on to Spring, which stops startup. -->
    <Match>
        <Class name="com.example.app.config.SecurityConfig"/>
        <Method name="securityFilterChain"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>
    <!-- roles:begin -->
    <Match> <!-- Rethrows a failure that is not a database outage while the permissions are read: it propagates as any other. -->
        <Class name="com.example.app.config.SecurityConfig"/>
        <Method name="readPermissions"/>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>
    <!-- roles:end -->
    <!-- session-version:begin -->
    <!-- Rethrows a failure that is not a database outage, so the error handling above answers it as any other. -->
    <Match>
        <Class name="com.example.app.common.security.SessionVersionFilter"/>
        <Method name="refusalOf"/>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>
    <!-- session-version:end -->

    <!-- Tenancy (overlays/tenancy): this file replaces the reference's in a copy with a tenancy mode. -->
    <!-- Logs three UUIDs (the staff member, the tenant, the account): none can carry a line break. -->
    <Match>
        <Class name="com.example.app.user.service.ImpersonationService"/>
        <Method name="impersonate"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <!-- Low priority, as above: CRLF_INJECTION_LOGS and SPRING_ENDPOINT per class, for the same reasons. -->
    <Match>
        <Class name="com.example.app.common.security.ActiveStaffFilter"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.service.MembershipService"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <!-- roles:begin -->
    <Match>
        <Class name="com.example.app.user.service.TenantMemberManager"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <!-- roles:end -->
    <Match>
        <Class name="com.example.app.user.service.PlatformAuthService"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <!-- tenant-registration:begin -->
    <Match>
        <Class name="com.example.app.user.service.TenantRegistrationService"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <!-- tenant-registration:end -->
    <Match>
        <Class name="com.example.app.tenant.controller.PlatformTenantController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.controller.MembershipController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.controller.PlatformAuthController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.controller.PlatformImpersonationController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.controller.PlatformUserController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Class name="com.example.app.user.controller.TenantMemberController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- metadata:begin -->
    <Match>
        <Class name="com.example.app.metadata.controller.PlatformMetadataController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- metadata:end -->
    <!-- tenant-registration:begin -->
    <Match>
        <Class name="com.example.app.user.controller.TenantRegistrationController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- tenant-registration:end -->
    <!-- HttpSecurity.build() declares Exception; the bean method passes it on to Spring, which stops startup. -->
    <Match>
        <Class name="com.example.app.config.PlatformSecurityConfig"/>
        <Method name="platformSecurityFilterChain"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>
    <!-- tenancy-row:begin -->
    <!-- Row mode: the provisioning's lines log the tenant id and a count. Hibernate's Service interface is Serializable;
         Hibernate never serializes a connection provider, which holds the data source. -->
    <Match>
        <Class name="com.example.app.tenant.service.TenantProvisioning"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.common.tenancy.TransactionLocalTenantProvider"/>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
    </Match>
    <!-- tenancy-row:end -->

    <!-- Schema per tenant (overlays/tenancy-schema): this file replaces the tenancy one in a copy of that mode. -->
    <!-- DDL takes no bind parameters: the schema name is TenantSchemas' (a fixed prefix and a UUID's hex digits, or the
         template's constant) and the role name goes through quote_ident. -->
    <Match>
        <Class name="com.example.app.tenant.service.TenantSchemaMigrator"/>
        <Method name="create"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>
    <Match>
        <Class name="com.example.app.tenant.service.TenantSchemaMigrator"/>
        <Method name="update"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>
    <!-- Low priority: the statements are the class's own constants (the advisory lock's two, the session's SET
         commands), never a value from outside. The migrations and the provisioning log tenant ids and counts. Hibernate's
         Service interface is Serializable; Hibernate never serializes a connection provider, which holds the data
         source. -->
    <Match>
        <Class name="com.example.app.common.tenancy.TransactionLocalSchemaProvider"/>
        <Method name="execute"/>
        <Bug pattern="SQL_INJECTION_JDBC"/>
    </Match>
    <Match>
        <Class name="com.example.app.tenant.service.TenantSchemaMigrator"/>
        <Method name="advisoryLock"/>
        <Bug pattern="SQL_INJECTION_JDBC"/>
    </Match>
    <Match>
        <Class name="com.example.app.tenant.service.TenantMigrations"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.tenant.service.TenantProvisioningJob"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Class name="com.example.app.common.tenancy.TransactionLocalSchemaProvider"/>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
    </Match>
</FindBugsFilter>
